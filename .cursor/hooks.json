{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "bash .cursor/hooks/before-shell-branch-policy.sh",
        "matcher": "(^|[;&|\\s])(([^\\s\"']+[/\\\\])*(git|git\\.exe|gh|gh\\.exe))(\\s|[\"']|$)",
        "timeout": 30,
        "failClosed": true
      }
    ]
  }
}

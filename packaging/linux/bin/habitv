#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LIB_DIR="$APP_ROOT/lib"

if ! command -v java >/dev/null 2>&1; then
  echo "Java 8 with JavaFX support is required but 'java' was not found on PATH." >&2
  echo "Install a JDK 8 distribution that includes JavaFX (for example Liberica JDK 8 Full)." >&2
  exit 1
fi

JAR=""
shopt -s nullglob
for candidate in "$LIB_DIR"/habiTv-*.jar; do
  JAR="$candidate"
  break
done

if [[ -z "$JAR" ]]; then
  echo "Habitv application JAR not found in $LIB_DIR" >&2
  exit 1
fi

exec java -jar "$JAR" "$@"
